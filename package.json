{
  "name": "ffr-edit",
  "version": "0.2.0",
  "description": "Final Fantasy Resonance save editor for Decky with Android and local web companions",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package_plugin.py",
    "test:web": "node tests/web.test.mjs",
    "test:native": "node tests/native.test.mjs",
    "test:integration": "node tests/web.integration.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:native && npm run test:web && npm run test:integration"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.15.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "jsdom": "^26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  }
}
